# ===== REQUIRED =====
# Google Gemini API Key (required for RAG generation)


# ===== OPTIONAL: CORS & Server =====
# Comma-separated list of allowed origins for CORS (default: localhost)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Server port (default: 8000)
PORT=8000

# ===== OPTIONAL: RAG Tuning (Production defaults recommended) =====
# Retrieval parameters
RAG_TOP_K=5
RAG_CANDIDATE_POOL=5
RAG_OVERSAMPLE_LIMIT=20
RAG_MIN_FINAL_SCORE=0.20
RAG_RETRIEVAL_CONF_THRESHOLD=0.55
RAG_DEMO_RETRIEVAL_CONF_THRESHOLD=0.35

# Embedding parameters
RAG_MAX_CHUNK_EMBED_TOKENS=420
RAG_EMBED_CACHE_SIZE=256
RAG_RETRIEVAL_CACHE_SIZE=256

# Generation parameters
RAG_MAX_CONTEXT_CHARS=15000
SENTENCE_SEMANTIC_THRESHOLD=0.60
MIN_SUPPORTED_SENTENCE_RATIO=0.60
MIN_TRUST_SCORE=0.62
RESPONSE_CACHE_SIZE=128

# Warmup (preload model on startup)
RAG_WARMUP=true

# Demo corpus mode
DEMO_MODE=true

# LLM Model (default: gemini-2.5-flash)
GOOGLE_MODEL=gemini-2.5-flash
